# ── Core ──────────────────────────────────────────────────────────────────────
# Production PostgreSQL connection. When omitted, the app uses an embedded
# PGlite database in .nuru/pgdata (local demo only).
# DATABASE_URL=postgres://user:password@host:5432/nuru

NODE_ENV=development

# Public URL of the platform (used for metadata, links and demo switching).
# On Render, RENDER_EXTERNAL_URL is used automatically when this is omitted.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Root domain for tenant subdomains. On Render use e.g. nuru.example.com
# Tenant hostnames resolve as <slug>.<ROOT_DOMAIN> once verified.
# When omitted, the hostname of the public URL is used.
ROOT_DOMAIN=localhost:3000

# Demo mode: enables clearly-labelled demo actions, one-click demo sign-in,
# the tenant switch cookie, seeded data and simulated outbound messaging.
DEMO_MODE=true
# Demo-only auto-login: when enabled with DEMO_MODE, dashboard pages and APIs
# treat a request without a session as the owner of the active demo tenant.
# Never enable this on a deployment that holds real customer data.
DEMO_AUTO_LOGIN=true
# Optional: force a specific demo account instead of the active tenant's owner.
# DEMO_AUTO_LOGIN_EMAIL=owner@amani.demo
# Secret used to sign sessions and demo-tenant cookies. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=

# ── AI provider (optional) ────────────────────────────────────────────────────
# mock (default) | openai
AI_PROVIDER=mock
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# ── Object storage (optional; demo uses bundled media + local adapter) ────────
# STORAGE_PROVIDER=s3
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_REGION=us-east-1
# S3_BUCKET=nuru-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=

# ── Email delivery (optional; simulated when unset) ───────────────────────────
# RESEND_API_KEY=
# EMAIL_FROM="Amani Bodywork <hello@example.com>"

# ── Observability ─────────────────────────────────────────────────────────────
LOG_LEVEL=info
